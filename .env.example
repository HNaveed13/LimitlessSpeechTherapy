# Copy to .env for local overrides. In production, set these in Vercel instead.

# Keystatic Cloud project as "team/project". When set, the production admin panel
# saves edits through Keystatic Cloud (editors do not need a GitHub account).
# Baked in at build time: redeploy after changing it.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Public URL of the site, used for canonical links and social previews.
SITE_URL=https://limitlessspeechandlanguagetherapy.com
